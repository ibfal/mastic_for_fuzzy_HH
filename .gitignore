# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

.idea/
.vscode/
.DS_Store

# Ignore config files
**/*.json

# Figs
*.pdf
*.png
!data/mosaic/*.json
# Benchmark manifest, ground truth and reference hotspots are data, not config.
!bench/**/*.json
# Benchmark plots (bench/scripts/evaluate.py, A10) are results, not scratch figures.
!bench/results/plots/**/*.png
!bench/results/plots/**/*.pdf
# Benchmark runner's configs, logs and scratch files (bench/scripts/run_bench.py).
bench/.run/
.venv/
__pycache__/
*.log
viz/logs/
viz/dist/
# Parking application (apps/parking/PARKING_PLAN.md): raw City of Melbourne downloads and the
# DuckDB/Parquet cache built from them are too large for git; their hashes are in raw_manifest.json.
apps/parking/raw/
!apps/parking/raw_manifest.json
# Parking data manifests and ground truth are data, not config.
!apps/parking/data/**/*.json
# Mastic's parking results (run_app.py, read by the frontend) are results, not config; the run
# configs and logs are scratch.
!apps/parking/results/*.json
apps/parking/.run/
