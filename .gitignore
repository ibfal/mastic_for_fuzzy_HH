# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

.idea/
.vscode/
.DS_Store

# Ignore config files
**/*.json

# Figs
*.pdf
*.png
!data/mosaic/*.json
# Benchmark manifest, ground truth and reference hotspots are data, not config.
!bench/**/*.json
# Benchmark runner's configs, logs and scratch files (bench/scripts/run_bench.py).
bench/.run/
.venv/
__pycache__/
*.log
viz/logs/
viz/dist/
